# SIP password of the PC softphone (user: pc)
PC_USER=pc
PC_PASSWORD=changeme
LOCAL_NET=192.168.1.0/24

# OVH trunk: fill OVH_* (from the OVH manager) to enable it
OVH_USER=0033XXXXXXXXX
OVH_DOMAIN=your-ovh-domain
OVH_PROXY=your-ovh-proxy
OVH_PASSWORD=

# Modem tuning
ANSWER_TONE_MS=0
TX_LEVEL=8000
CARRIER_THRESHOLD=200000
RECORD_DIR=/data/calls
LOG_LEVEL=INFO
